ninja_required_version = 1.3
cxx = c++
nvcc = /root/miniconda3/envs/lion/bin/nvcc

cflags = -pthread -B /root/miniconda3/envs/lion/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /root/miniconda3/envs/lion/include -fPIC -O2 -isystem /root/miniconda3/envs/lion/include -fPIC -I/root/miniconda3/envs/lion/lib/python3.10/site-packages/torch/include -I/root/miniconda3/envs/lion/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/root/miniconda3/envs/lion/lib/python3.10/site-packages/torch/include/TH -I/root/miniconda3/envs/lion/lib/python3.10/site-packages/torch/include/THC -I/root/miniconda3/envs/lion/include -I/root/miniconda3/envs/lion/include/python3.10 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=wkv6_cuda -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/root/miniconda3/envs/lion/lib/python3.10/site-packages/torch/include -I/root/miniconda3/envs/lion/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/root/miniconda3/envs/lion/lib/python3.10/site-packages/torch/include/TH -I/root/miniconda3/envs/lion/lib/python3.10/site-packages/torch/include/THC -I/root/miniconda3/envs/lion/include -I/root/miniconda3/envs/lion/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=wkv6_cuda -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





build /root/autodl-tmp/lion-jiamivoxelsprse-autodl-ceshitime/build/temp.linux-x86_64-cpython-310/pcdet/ops/wkv6/src/wkv6_cuda.o: cuda_compile /root/autodl-tmp/lion-jiamivoxelsprse-autodl-ceshitime/pcdet/ops/wkv6/src/wkv6_cuda.cu
build /root/autodl-tmp/lion-jiamivoxelsprse-autodl-ceshitime/build/temp.linux-x86_64-cpython-310/pcdet/ops/wkv6/src/wkv6_op.o: compile /root/autodl-tmp/lion-jiamivoxelsprse-autodl-ceshitime/pcdet/ops/wkv6/src/wkv6_op.cpp






